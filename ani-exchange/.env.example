# Postgres (dev local). Producción: URL de Neon.
DATABASE_URL=postgres://hanazo@localhost:5432/aniexchange
# Base separada para pruebas que tocan DB
TEST_DATABASE_URL=postgres://hanazo@localhost:5432/aniexchange_test

# Better Auth: genera con `openssl rand -base64 32`
AUTH_SECRET=

# App de Discord (https://discord.com/developers/applications)
# Redirect OAuth2: ${APP_BASE_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

CRON_SECRET=
# Discord IDs separados por comas que reciben rol superadmin al iniciar sesión
SUPERADMIN_DISCORD_IDS=

APP_TIMEZONE=America/Hermosillo
APP_BASE_URL=http://localhost:3000
